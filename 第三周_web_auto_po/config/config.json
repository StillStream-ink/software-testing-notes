{
  "environment": "test",
  "base_url": "https://www.saucedemo.com",
  "browser": {
    "headless": true,
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "locale": "zh-CN",
    "default_timeout": 30000,
    "action_timeout": 5000,
    "trace": {
      "enabled": true,
      "retain_on_failure": true
    }
  },
  "test_data": {
    "checkout_info": {
      "first_name": "Test",
      "last_name": "User",
      "postal_code": "12345"
    },
    "item_count": 2
  },
  "allure": {
    "report_title": "SauceDemo 自动化测试报告",
    "report_language": "zh",
    "history_enabled": true
  },
  "retry": {
    "failed_retries": 1,
    "flaky_retries": 2
  }
}